    "nodes_max": 5000,
    "node_val_min": -1000,
    "node_val_max": 1000,
    "target_min": -1000,
    "target_max": 1000
  },
  "examples": [
    {
      "target": 22,
      "expected": true
    },
    {
      "tree": [
        1,
        2,
        3
