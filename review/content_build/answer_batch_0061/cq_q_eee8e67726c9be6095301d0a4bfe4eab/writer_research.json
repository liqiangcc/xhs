      "claim_id": "monitor-semantics",
      "text": "Java synchronization is defined in terms of object monitors; synchronized statements lock the monitor associated with the evaluated non-null object, synchronized methods acquire the corresponding instance/Class monitor, and monitor unlock happens-before a subsequent lock of the same monitor.",
      "source_ids": ["jls-17", "jls-14"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制"]
    },
    {
      "claim_id": "lock-memory-semantics",
      "text": "The Lock contract requires successful lock and unlock operations to provide the same memory synchronization effects as built-in monitor Lock and Unlock actions.",
      "source_ids": ["lock-api"],
      "answer_locations": ["核心结论", "1 分钟版", "关键细节", "原理机制", "常见追问"]
    },
    {
      "claim_id": "reentrantlock-capabilities",
      "text": "ReentrantLock is reentrant and provides explicit lock/unlock plus interruptible acquisition, immediate/timed tryLock, an optional fairness policy, Condition creation, and monitoring methods; fair scheduling is not equivalent to overall thread-scheduling fairness and untimed tryLock may barge.",
      "source_ids": ["reentrantlock-api"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "常见追问"]
