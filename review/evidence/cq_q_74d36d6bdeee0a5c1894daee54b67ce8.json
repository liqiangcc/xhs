    {"claim_id": "maven-mediation-boundary", "text": "Maven documents dependency mediation as nearest definition; at equal depth the first declaration wins, and an explicit POM dependency can guarantee a version.", "source_ids": ["maven-dependency-mechanism"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
    {"claim_id": "maven-dependency-tree-boundary", "text": "The Maven Dependency Plugin documents the dependency:tree goal and its verbose parameter for dependency-tree output; the candidate uses that output as build-graph evidence only.", "source_ids": ["maven-dependency-tree-plugin"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问"]},
    {"claim_id": "java-se21-loader-observation-boundary", "text": "Java SE 21 documents that Class objects expose their defining ClassLoader, possibly null for bootstrap, and that the default ClassLoader loadClass implementation checks loaded classes, delegates to its parent, then calls findClass; implementations may override loading behavior.", "source_ids": ["java-se21-classloader", "java-se21-class"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
    {"claim_id": "java-se21-codesource-observation-boundary", "text": "Java SE 21 documents Class.getProtectionDomain, ProtectionDomain.getCodeSource and CodeSource.getLocation; the candidate treats a non-null location only as an observation and explicitly allows CodeSource/location to be absent or non-JAR.", "source_ids": ["java-se21-class", "java-se21-protection-domain", "java-se21-code-source"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
