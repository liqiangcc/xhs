  "claims": [
    {"claim_id":"two-message-models","text":"For the classic RocketMQ MessageModel/interview meaning of consumption mode, there are two modes: Clustering and Broadcasting.","source_ids":["rocketmq4-consumer-core-concept","rocketmq4-push-consumer","rocketmq5-consumer-load-balancing","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","常见追问"]},
    {"claim_id":"clustering-semantics","text":"In Clustering mode, consumers in the same Consumer Group share the subscribed message workload and group-level load balancing allocates work among consumers; adding consumers is a horizontal-capacity mechanism subject to available allocation units and downstream limits.","source_ids":["rocketmq4-consumer-core-concept","rocketmq4-push-consumer","rocketmq5-consumer-load-balancing","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制","常见追问"]},
    {"claim_id":"broadcasting-semantics","text":"In Broadcasting mode, each consumer in the Consumer Group receives the full subscribed message stream, so adding a consumer creates another full consumer rather than splitting one workload.","source_ids":["rocketmq4-consumer-core-concept","rocketmq4-push-consumer","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制","常见追问"]},
    {"claim_id":"classification-and-version-boundary","text":"Push/Pull and current PushConsumer/SimpleConsumer/PullConsumer APIs describe a different consumer acquisition/type dimension, while concurrent/orderly consumption describes processing behavior. The 4.x Java PushConsumer documentation exposes MessageModel.CLUSTERING/BROADCASTING and documents clustering as the default for that API.","source_ids":["rocketmq4-consumer-core-concept","rocketmq4-push-consumer","rocketmq5-consumer-domain-model","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","常见追问","易错点"]}
