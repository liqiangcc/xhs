  "claims": [
    {"claim_id":"common-models","text":"The candidate explains common Unix/Linux IPC through distinct byte-channel, message, shared-state, synchronization, local socket and signal-notification models rather than presenting an unstructured API list.","source_ids":["repository-source","primary-source-packet","linux-pipe7","linux-sysvipc7","linux-unix7","linux-signal7","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","原理机制"]},
    {"claim_id":"pipes-fifos-queues","text":"Pipes/FIFOs are bounded unidirectional channels; anonymous pipes fit related-process descriptor inheritance while FIFOs add a filesystem rendezvous name. Message queues exchange explicit messages and have kernel resource/lifecycle limits.","source_ids":["linux-pipe7","linux-fifo7","linux-mq7","linux-sysvipc7","isolated-review"],"answer_locations":["1 分钟版","3 分钟版","关键细节","常见追问"]},
    {"claim_id":"shared-memory-sync","text":"Shared memory gives processes access to a shared memory region, while correct concurrent access needs a separate synchronization protocol. Semaphores synchronize actions and are not ordinary bulk-payload transports.","source_ids":["linux-shm7","linux-sem7","linux-sysvipc7","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制","常见追问","易错点"]},
    {"claim_id":"unix-sockets-signals-selection","text":"AF_UNIX sockets provide efficient local process communication with stream/datagram/seqpacket choices, while signals are asynchronous control/notification mechanisms. Selection is workload-dependent and the answer rejects universal fastest-mechanism claims.","source_ids":["linux-unix7","linux-signal7","primary-source-packet","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","项目经验版","常见追问","易错点"]}
