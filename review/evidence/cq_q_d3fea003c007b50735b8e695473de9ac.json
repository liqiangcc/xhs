  "claims": [
    {
      "claim_id": "collector-architecture-comparison",
      "text": "CMS primarily reduces old-generation pauses by running most tracing and sweeping concurrently without normal compaction, while G1 organizes the heap into Regions and reclaims selected Collection Sets by stop-the-world evacuation that also compacts memory.",
      "source_ids": [
        "oracle-j8-cms",
        "oracle-j8-g1",
        "oracle-j8-g1-tuning",
        "isolated-review"
      ],
      "answer_locations": [
        "核心结论",
        "1 分钟版",
        "3 分钟版",
        "原理机制"
      ]
    },
    {
      "claim_id": "cms-pause-and-failure-boundaries",
      "text": "CMS still has initial-mark and remark stop-the-world pauses; concurrent phases consume CPU, can leave floating garbage, and can fail to complete before usable old-generation space is exhausted, producing concurrent mode failure.",
      "source_ids": [
        "oracle-j8-cms",
        "oracle-j9-cms-deprecation",
        "isolated-review"
      ],
      "answer_locations": [
        "1 分钟版",
        "3 分钟版",
        "关键细节",
        "常见追问",
        "易错点"
      ]
    },
    {
      "claim_id": "g1-region-remembered-set-mechanism",
      "text": "G1 uses Region-local collection, Collection Sets, evacuation and remembered-set/write-barrier machinery so selected Regions can be reclaimed without scanning the entire heap; remembered-set refinement and scanning have CPU, memory and pause costs.",
      "source_ids": [
        "oracle-j8-g1",
        "oracle-j8-g1-tuning",
        "oracle-j25-g1-tuning",
        "isolated-review"
      ],
      "answer_locations": [
        "核心结论",
        "1 分钟版",
        "3 分钟版",
        "关键细节",
        "原理机制",
        "常见追问"
      ]
    },
    {
      "claim_id": "pause-target-boundary",
      "text": "G1 uses a history-based pause prediction model to choose collection work against a soft pause target; young and mixed evacuation remains stop-the-world and MaxGCPauseMillis is not a hard real-time SLA.",
      "source_ids": [
        "oracle-j8-g1",
        "oracle-j8-g1-tuning",
        "oracle-j25-g1-tuning",
        "isolated-review"
      ],
      "answer_locations": [
        "核心结论",
        "1 分钟版",
        "3 分钟版",
        "关键细节",
        "常见追问",
        "易错点"
      ]
    },
    {
      "claim_id": "version-aware-selection",
      "text": "G1 became the default collector in JDK 9 and later; CMS was deprecated in JDK 9 and removed in JDK 14, so modern JDK selection should not treat CMS as a current deployment option, while historical JDK 8 migration should be validated under the same workload instead of assuming universal superiority.",
