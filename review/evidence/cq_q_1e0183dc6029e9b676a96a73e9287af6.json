  "claims": [
    {"claim_id":"four-levels-default","text":"InnoDB supports READ UNCOMMITTED, READ COMMITTED, REPEATABLE READ and SERIALIZABLE, with REPEATABLE READ as the default isolation level; a concrete connection can override the default through global/session/next-transaction configuration.","source_ids":["mysql84-isolation-levels","mysql84-transaction-isolation-variable","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","常见追问"]},
    {"claim_id":"rc-rr-read-view","text":"READ COMMITTED creates a fresh snapshot for each InnoDB consistent read while REPEATABLE READ reuses the snapshot established by the first consistent read in the transaction, explaining the core repeatability difference for ordinary SELECT statements.","source_ids":["mysql84-isolation-levels","mysql84-consistent-read","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制","常见追问"]},
    {"claim_id":"snapshot-locking-boundary","text":"Ordinary consistent nonlocking reads are distinct from SELECT FOR UPDATE/FOR SHARE and DML. Under RR, locking/range access can use record, gap or next-key locking, so phantom-related behavior must be analyzed by access path rather than reduced to a single MVCC-only or locking-only slogan.","source_ids":["mysql84-isolation-levels","mysql84-consistent-read","mysql84-locking-reads","isolated-review"],"answer_locations":["1 分钟版","3 分钟版","关键细节","原理机制","常见追问","易错点"]},
    {"claim_id":"ru-serializable-boundaries","text":"READ UNCOMMITTED permits dirty/inconsistent reads, while SERIALIZABLE is stricter than RR and with autocommit disabled treats plain SELECT as SELECT FOR SHARE, increasing serialization and locking tradeoffs.","source_ids":["mysql84-isolation-levels","mysql84-locking-reads","isolated-review"],"answer_locations":["1 分钟版","3 分钟版","关键细节","常见追问"]}
