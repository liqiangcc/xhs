      "claim_id": "end-to-end-boundary",
      "text": "Message-loss prevention is split across publisher-to-broker confirmation, broker-side durable or replicated storage, and consumer processing acknowledgement; publisher confirms and consumer acknowledgements are orthogonal.",
      "source_ids": ["rabbitmq-4.2-confirms", "rabbitmq-4.2-reliability", "isolated-review"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "原理机制"]
    },
    {
      "claim_id": "publisher-routing-boundary",
      "text": "Publisher confirms establish broker acceptance while mandatory/basic.return addresses unroutable publication when routing success is part of the application contract.",
      "source_ids": ["rabbitmq-4.2-confirms", "rabbitmq-4.2-reliability", "isolated-review"],
      "answer_locations": ["1 分钟版", "3 分钟版", "关键细节", "常见追问"]
    },
    {
      "claim_id": "durability-replication-boundary",
      "text": "Durable queues and persistent publications address restart recovery, while quorum queues add replicated data-safety semantics whose confirm boundary depends on quorum acceptance and majority availability.",
      "source_ids": ["rabbitmq-4.2-queues", "rabbitmq-4.2-quorum-queues", "rabbitmq-4.2-confirms", "isolated-review"],
      "answer_locations": ["1 分钟版", "3 分钟版", "关键细节", "原理机制"]
    },
    {
      "claim_id": "consumer-duplicate-boundary",
      "text": "Manual acknowledgement after business success enables redelivery on failure; retries and redelivery can create duplicates, so business effects must be idempotent or deduplicated rather than described as exactly-once.",
      "source_ids": ["rabbitmq-4.2-confirms", "rabbitmq-4.2-reliability", "rabbitmq-4.2-nack", "isolated-review"],
