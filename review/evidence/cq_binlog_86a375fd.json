  "claims": [
    {
      "claim_id": "binlog-format-boundary",
      "text": "In MySQL 8.4, STATEMENT logs SQL statements, ROW logs changed-row events and is the default, while MIXED uses statement logging by default and changes to row logging in specified cases; unsafe statement replication is a format boundary.",
      "source_ids": ["mysql-binlog-format"],
      "answer_locations": ["核心结论", "1 分钟版", "关键细节", "常见追问"]
    },
    {
      "claim_id": "replication-source-replica-flow",
      "text": "A replica requests the source binary log, writes it locally as a relay log before processing, tracks source and relay positions, and later executes the received events; receipt and application are therefore distinct stages.",
      "source_ids": ["mysql-replication-implementation"],
      "answer_locations": ["1 分钟版", "3 分钟版", "原理机制", "常见追问"]
    },
    {
      "claim_id": "semisync-acknowledgement-boundary",
      "text": "With semisynchronous replication, the source waits for configured replica acknowledgements after receipt and relay-log flush, not for the events to have been executed and committed by the replica; on timeout without an acknowledgement it reverts to asynchronous replication.",
      "source_ids": ["mysql-semisync"],
      "answer_locations": ["1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]
    },
    {
      "claim_id": "replica-parallel-applier-boundary",
      "text": "For MySQL 8.4, replica_parallel_workers enables a coordinator that reads transactions from the relay log and schedules worker threads; more workers raise only potential parallelism and can be limited by concurrency effects and workload shape.",
      "source_ids": ["mysql-replica-parallel-workers"],
      "answer_locations": ["3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]
    }
