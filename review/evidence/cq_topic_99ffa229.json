  "claims": [
    {"claim_id": "mysql-index-left-prefix-and-cost", "text": "MySQL 8.4 states that any leftmost prefix of a multiple-column index can be used for lookup, that the optimizer normally chooses the most selective candidate index, and that sequential reading can be faster when most rows are accessed; it also documents index maintenance and space costs.", "source_ids": ["mysql-8-4-index-use"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
    {"claim_id": "mysql-index-like-range-boundary", "text": "MySQL 8.4 range optimization lists LIKE patterns that do not begin with a wildcard as range conditions; the candidate limits the leading-wildcard conclusion to ordinary B-tree prefix-range access.", "source_ids": ["mysql-8-4-range-optimization"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
    {"claim_id": "mysql-index-expression-generated-column-boundary", "text": "MySQL 8.4 documents that an optimizer can consider an indexed generated column when a WHERE, ORDER BY, or GROUP BY expression matches its definition, with documented matching restrictions.", "source_ids": ["mysql-8-4-generated-column-index"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "原理机制", "常见追问", "易错点"]},
    {"claim_id": "mysql-implicit-conversion-is-contextual", "text": "MySQL 8.4 documents implicit type conversion for operands of different types; the candidate deliberately does not turn this into an unconditional index-use rule and requires plan verification.", "source_ids": ["mysql-8-4-type-conversion"], "answer_locations": ["关键细节", "项目经验版", "易错点"]}
    ,{"claim_id": "mysql-explain-verifies-index-use", "text": "MySQL 8.4 explicitly directs users to use EXPLAIN to verify whether queries use created indexes.", "source_ids": ["mysql-8-4-verifying-index-usage"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "项目经验版", "常见追问", "易错点"]}
