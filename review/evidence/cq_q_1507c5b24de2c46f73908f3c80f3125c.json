    {
      "claim_id": "source-boundary",
      "text": "All frozen source variants ask for the difference between synchronized and ReentrantLock; the candidate stays on that technical comparison and covers the mechanism-depth variant without inventing project history.",
      "source_ids": ["repository-source"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "原理机制", "项目经验版"]
    },
    {
      "claim_id": "monitor-lifecycle-reentrancy",
      "text": "A synchronized statement locks the selected object's monitor, releases it after either normal or abrupt block completion, and permits the same thread to acquire the monitor repeatedly with balanced unlock effects.",
      "source_ids": ["jls-se21-synchronized", "jls-se21-locks-memory"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "常见追问"]
    },
    {
      "claim_id": "lock-lifecycle-capabilities",
      "text": "Lock removes block-structured automatic release and therefore requires explicit unlock discipline, while exposing non-blocking tryLock, timed tryLock and lockInterruptibly acquisition forms not exposed as equivalent controls by synchronized syntax.",
      "source_ids": ["lock-api-se21", "reentrantlock-api-se21"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "项目经验版", "常见追问"]
    },
    {
      "claim_id": "memory-semantics",
      "text": "Successful Lock lock/unlock operations are required to provide the same memory synchronization effects as built-in monitor lock/unlock, and an unlock on a monitor happens-before each subsequent lock on that monitor.",
      "source_ids": ["lock-api-se21", "jls-se21-locks-memory"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "原理机制", "常见追问"]
    },
    {
      "claim_id": "fairness-and-trylock-boundary",
      "text": "ReentrantLock optionally uses a fair acquisition policy, but lock fairness is not thread-scheduler fairness; untimed tryLock may barge even on a fair lock, while timed acquisition can honor the fair policy.",
      "source_ids": ["reentrantlock-api-se21", "openjdk-reentrantlock-jdk21ga"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "常见追问", "易错点"]
    },
    {
      "claim_id": "condition-model",
      "text": "Condition factors Object monitor wait/notify behavior into Lock-associated condition objects, permits multiple wait-sets per Lock, and await atomically releases then reacquires the associated lock before return.",
      "source_ids": ["condition-api-se21", "lock-api-se21"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "常见追问"]
    },
    {
      "claim_id": "implementation-version-boundary",
      "text": "OpenJDK 21 GA implements ReentrantLock with AbstractQueuedSynchronizer-backed Sync, FairSync and NonfairSync variants and state-backed hold counting; these are version-bound implementation mechanics rather than language-level synchronized guarantees.",
      "source_ids": ["openjdk-reentrantlock-jdk21ga", "jls-se21-synchronized"],
      "answer_locations": ["3 分钟版", "原理机制", "关键细节", "易错点"]
    }
