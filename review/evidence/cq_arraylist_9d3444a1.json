      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "易错点"]
    },
    {
      "claim_id": "arraylist-index-insert-and-concurrency-boundary",
      "text": "Java SE 21 specifies that ArrayList indexed insertion shifts the current and subsequent elements, is not synchronized, and has best-effort rather than correctness-guaranteeing fail-fast iterators.",
      "source_ids": ["java-se21-arraylist"],
      "answer_locations": ["关键细节", "3 分钟版", "原理机制", "常见追问"]
    },
    {
      "claim_id": "arraylist-capacity-and-null-contract",
      "text": "Java SE 21 documents ArrayList capacity as the size of its backing array, allows null elements, and provides ensureCapacity to increase capacity when necessary.",
      "source_ids": ["java-se21-arraylist"],
      "answer_locations": ["关键细节", "3 分钟版"]
    },
    {
      "claim_id": "linkedlist-structure-and-index-boundary",
      "text": "Java SE 21 specifies LinkedList as a doubly-linked List and Deque; indexed operations traverse from the nearer end, so indexing carries traversal cost.",
      "source_ids": ["java-se21-linkedlist"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]
    },
    {
      "claim_id": "linkedlist-deque-and-concurrency-boundary",
      "text": "Java SE 21 documents LinkedList Deque operations, external synchronization for structural concurrent modification, and best-effort fail-fast iterator behavior.",
      "source_ids": ["java-se21-linkedlist"],
      "answer_locations": ["1 分钟版", "3 分钟版", "关键细节", "常见追问"]
