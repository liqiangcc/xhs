    {"claim_id": "six-jvm-states", "text": "Java SE 21 defines exactly NEW, RUNNABLE, BLOCKED, WAITING, TIMED_WAITING and TERMINATED as Thread.State values; a thread is in only one at a time and the states do not reflect operating-system thread states.", "source_ids": ["java-se21-thread-state"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "易错点"]},
    {"claim_id": "state-causes-and-boundaries", "text": "Java SE 21 specifies BLOCKED as monitor-lock waiting, documents WAITING triggers and TIMED_WAITING only for specified positive waiting time, and states that RUNNABLE may wait for operating-system resources such as processor.", "source_ids": ["java-se21-thread-state"], "answer_locations": ["1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
    {"claim_id": "start-and-termination", "text": "Java SE 21 documents that start schedules a thread to execute run, and that a thread terminates when run completes normally or abruptly after its uncaught-exception handler completes.", "source_ids": ["java-se21-thread"], "answer_locations": ["1 分钟版", "3 分钟版", "原理机制"]}
