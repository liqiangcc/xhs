      "answer_locations": ["关键细节", "项目经验版", "常见追问", "易错点"]
    },
    {
      "claim_id": "fairness-tradeoff",
      "text": "OpenJDK documents the usual fair-lock trade-off under contention: potentially lower overall throughput in exchange for smaller acquisition-time variance and lack-of-starvation guarantees at the lock policy level.",
