      "claim_id": "aqs-policy-separation",
      "text": "OpenJDK 21 GA AQS supplies synchronization-state and FIFO wait-queue/acquire/release mechanics while allowing barging policies; ReentrantLock subclasses supply the actual fair/non-fair admission policy.",
      "source_ids": ["openjdk-aqs-jdk21ga", "openjdk-reentrantlock-jdk21ga"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制"]
    },
    {
      "claim_id": "fair-vs-nonfair-admission",
      "text": "The non-fair synchronizer can CAS an available state without predecessor checks, while the fair synchronizer gates the CAS on queue-state/predecessor checks; both use the AQS queue after acquisition failure.",
      "source_ids": ["openjdk-reentrantlock-jdk21ga", "openjdk-aqs-jdk21ga"],
      "answer_locations": ["核心结论", "3 分钟版", "关键细节", "原理机制", "常见追问"]
    },
    {
      "claim_id": "reentrancy-release-boundary",
      "text": "Both policies preserve owner reentrancy by incrementing the hold count, and release only clears ownership when the hold count reaches zero.",
      "source_ids": ["openjdk-reentrantlock-jdk21ga"],
      "answer_locations": ["核心结论", "1 分钟版", "关键细节", "常见追问", "易错点"]
    },
    {
      "claim_id": "fairness-boundaries",
      "text": "Fairness is a lock-admission policy rather than JVM/OS scheduling fairness, and untimed tryLock() does not honor the fairness setting.",
