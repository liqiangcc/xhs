  "claims": [
    {"claim_id":"ownership-and-release","text":"Thread.sleep pauses the current thread without requiring or releasing a target monitor. Object.wait requires ownership of the target object's monitor, joins that object's wait set and relinquishes synchronization claims on that object only; monitors on other objects remain held.","source_ids":["java26-thread-sleep","java26-object-wait","jls26-waitsets","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制","常见追问"]},
    {"claim_id":"wake-reacquire-and-condition-loop","text":"sleep is duration-based subject to timer/scheduler precision, while wait is condition-notification oriented and may return via notification, interruption, timeout or spurious wakeup. A waiter must reacquire the object's monitor before proceeding, and the API recommends checking the condition in a while loop.","source_ids":["java26-thread-sleep","java26-object-wait","jls26-waitsets","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制","常见追问","易错点"]},
    {"claim_id":"interruption","text":"Both sleep and wait have documented InterruptedException paths and clear interrupted status when that exception is thrown. For wait, the object's lock state is restored/reacquired before the exception is delivered.","source_ids":["java26-thread-sleep","java26-object-wait","jls26-waitsets","isolated-review"],"answer_locations":["1 分钟版","3 分钟版","关键细节","常见追问"]},
    {"claim_id":"selection-boundary","text":"The candidate uses sleep for deliberate delay/backoff and wait/notify for monitor-protected condition coordination, with higher-level java.util.concurrent constructs framed only as engineering alternatives for more complex coordination rather than as a different definition of sleep or wait.","source_ids":["primary-source-packet","isolated-review"],"answer_locations":["核心结论","1 分钟版","3 分钟版","项目经验版"]}
