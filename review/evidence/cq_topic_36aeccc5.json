  "claims": [
    {
      "claim_id": "threadpool-rejection-trigger-and-handler",
      "text": "Java SE 21 documents rejection when the executor is shut down or when both maximum threads and work-queue capacity are finite and the executor is saturated; execute then invokes RejectedExecutionHandler.rejectedExecution. Constructors that do not accept an explicit handler use the documented default handler, AbortPolicy.",
      "source_ids": ["java-21-threadpoolexecutor-api", "java-21-abort-policy-api"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]
    },
    {
      "claim_id": "threadpool-predefined-policies",
      "text": "Java SE 21 defines AbortPolicy to throw RejectedExecutionException, CallerRunsPolicy to execute the rejected task in the calling thread when not shut down, DiscardPolicy to discard rejected tasks, and DiscardOldestPolicy to discard the queue head and retry execute when not shut down.",
      "source_ids": ["java-21-abort-policy-api", "java-21-caller-runs-policy-api", "java-21-discard-policy-api", "java-21-discard-oldest-policy-api"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]
    },
    {
      "claim_id": "threadpool-caller-runs-feedback",
      "text": "ThreadPoolExecutor documentation describes caller-runs as a simple feedback control mechanism that slows the rate at which new tasks are submitted. The candidate treats latency-sensitive caller-thread suitability as an explicit design tradeoff rather than a universal JDK guarantee.",
      "source_ids": ["java-21-threadpoolexecutor-api", "java-21-caller-runs-policy-api"],
      "answer_locations": ["1 分钟版", "3 分钟版", "原理机制", "项目经验版", "常见追问"]
    },
    {
      "claim_id": "threadpool-discard-boundaries",
      "text": "Java SE 21 documents DiscardPolicy for tasks whose completion is never relied upon and describes DiscardOldestPolicy as rarely acceptable because it discards the oldest unhandled request and retries, without understanding application priority.",
      "source_ids": ["java-21-threadpoolexecutor-api", "java-21-discard-policy-api", "java-21-discard-oldest-policy-api"],
