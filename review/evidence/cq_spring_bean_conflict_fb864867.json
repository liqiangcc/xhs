    {"claim_id": "spring-same-name-registration-and-framework-boundary", "text": "Spring Framework defines bean overriding as registering a bean with an already allocated identifier; setting allowBeanDefinitionOverriding false before ApplicationContext refresh causes an exception, while current reference documentation describes INFO logging by default and documents the matching @Bean/scanned-component override boundary.", "source_ids": ["spring-framework-bean-overview-current"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
    {"claim_id": "spring-override-exception-registration", "text": "Spring Framework 7.0.8 documents BeanDefinitionOverrideException (since 5.1) as an invalid override attempt, typically registering a new definition with the same bean name while DefaultListableBeanFactory bean-definition overriding is false.", "source_ids": ["spring-framework-7-bean-override-exception"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "原理机制", "常见追问"]},
    {"claim_id": "spring-boot-override-default", "text": "Spring Boot 4.0 documents spring.main.allow-bean-definition-overriding as controlling registration with an existing name and lists its default as false.", "source_ids": ["spring-boot-4-common-properties"], "answer_locations": ["1 分钟版", "3 分钟版", "关键细节", "常见追问", "易错点"]},
