  "claims": [
    {"claim_id":"clone-sharing-boundary","text":"Linux clone/clone3 controls whether a child shares virtual address space, file descriptor table, and signal-handler table with the caller, so process/thread resource-sharing statements require platform boundaries.","source_ids":["linux-clone"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制","常见追问","易错点"]},
    {"claim_id":"clone-stack-boundary","text":"Linux clone documentation states that when memory is shared, the caller must set up memory space for the child stack; the child cannot execute on the caller's same stack.","source_ids":["linux-clone"],"answer_locations":["3 分钟版","关键细节","原理机制","常见追问","易错点"]},
    {"claim_id":"fork-address-space-boundary","text":"Linux fork creates a child with its own virtual address space and uses copy-on-write so copying of memory pages is deferred, so full-memory-copy claims need qualification.","source_ids":["linux-fork"],"answer_locations":["1 分钟版","3 分钟版","关键细节","原理机制","常见追问","易错点"]},
    {"claim_id":"pthreads-sharing-and-execution","text":"POSIX threads documentation states that one process can contain multiple threads executing the same program; they share global memory and several process-wide attributes while each has its own stack and thread identifier.","source_ids":["posix-pthreads"],"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制","常见追问","易错点"]}
