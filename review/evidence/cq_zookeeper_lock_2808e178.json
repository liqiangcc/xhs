    {"claim_id": "zookeeper-lock-recipe-predecessor-watch", "text": "ZooKeeper's official lock recipe creates a GUID-prefixed sequential ephemeral node, grants the lock to the lowest process node, and has other clients watch the node with the next lowest sequence number rather than polling or watching all waiters; the recipe documents the GUID recovery case after an ambiguous create response.", "source_ids": ["zookeeper-recipes-locks-r372"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
    {"claim_id": "zookeeper-ephemeral-sequential-boundary", "text": "ZooKeeper 3.9.5 documents EPHEMERAL_SEQUENTIAL as a znode deleted upon client disconnect with a monotonically increasing suffix appended to its name.", "source_ids": ["zookeeper-395-create-mode"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
    {"claim_id": "zookeeper-watch-and-session-boundary", "text": "ZooKeeper's client API documents that ephemeral nodes are removed when the associated session expires, sequential paths receive a suffix, and create/delete operations trigger the relevant exists, getData, and getChildren watches.", "source_ids": ["zookeeper-363-client-api"], "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]},
