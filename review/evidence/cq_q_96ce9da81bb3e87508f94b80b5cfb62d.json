  "claims": [
    {
      "claim_id": "lifetime-and-management-model",
      "text": "The useful generic distinction is lifecycle and management model: call-frame stack storage commonly follows structured nested lifetime, while dynamic/heap storage supports allocations whose lifetime need not end with the allocating call and therefore requires an independent reclamation policy.",
      "source_ids": [
        "linux-man-pages-alloca",
        "linux-man-pages-malloc",
        "isolated-review"
      ],
      "answer_locations": [
        "核心结论",
        "1 分钟版",
        "3 分钟版",
        "原理机制"
      ]
    },
    {
      "claim_id": "jvm-runtime-boundary",
      "text": "JVMS 26 defines a private JVM stack for each JVM thread and a heap shared among JVM threads; JVM stacks store frames used for invocation/return and the JVM heap is automatically managed. These are JVM-specific specification guarantees, not universal language-independent placement rules.",
      "source_ids": [
        "jvms26-jvm-stacks",
        "jvms26-heap",
        "isolated-review"
      ],
      "answer_locations": [
        "1 分钟版",
        "3 分钟版",
        "关键细节",
        "常见追问",
        "易错点"
      ]
    },
    {
      "claim_id": "failure-boundary",
      "text": "Stack exhaustion and dynamic-allocation exhaustion are distinct failure classes, while their concrete manifestations depend on the language/runtime; Linux alloca can overflow the stack, malloc can fail with ENOMEM, and JVM stack demand can raise StackOverflowError.",
      "source_ids": [
        "linux-man-pages-alloca",
        "linux-man-pages-malloc",
        "jvms26-jvm-stacks",
        "isolated-review"
      ],
      "answer_locations": [
        "1 分钟版",
        "3 分钟版",
        "关键细节",
        "常见追问"
      ]
    },
    {
      "claim_id": "non-absolute-implementation-rules",
      "text": "Heap-versus-stack explanations should not promote common implementation patterns into universal rules: fixed sizes, physical placement of all locals/objects, automatic cross-thread sharing of every dynamic object, manual release of every heap object, or an unconditional stack-is-faster rule are all over-generalizations.",
      "source_ids": [
        "primary-source-packet",
        "jvms26-jvm-stacks",
        "jvms26-heap",
        "isolated-review"
      ],
      "answer_locations": [
        "核心结论",
        "1 分钟版",
        "3 分钟版",
        "关键细节",
        "常见追问",
        "易错点"
      ]
    },
    {
      "claim_id": "mechanism-chain",
      "text": "Structured LIFO frame lifetime permits simple frame allocation/reclamation, while independently ordered dynamic lifetimes require separate allocation/reclamation machinery; this difference explains common allocator metadata, fragmentation, concurrency and performance tradeoffs without asserting a universal performance law.",
