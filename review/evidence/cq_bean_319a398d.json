  "claims": [
    {
      "claim_id": "lifecycle-callback-order",
      "text": "Spring Framework 7.0.8 documents that InitializingBean.afterPropertiesSet and DisposableBean.destroy are lifecycle callbacks; when different methods are configured through multiple lifecycle mechanisms, initialization runs @PostConstruct, afterPropertiesSet, then a custom init method, and destruction runs @PreDestroy, destroy, then a custom destroy method; same method names run once.",
      "source_ids": ["spring7-lifecycle", "spring7-lifecycle-annotations"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]
    },
    {
      "claim_id": "container-extension-boundaries",
      "text": "Spring Framework 7.0.8 documents that BeanFactoryPostProcessor operates on configuration metadata before ordinary beans are instantiated, while BeanPostProcessor operates on bean instances and receives callbacks before and after initialization methods; BeanNameAware is invoked after normal property population and before initialization callbacks.",
      "source_ids": ["spring7-extension", "spring7-lifecycle"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]
    },
    {
      "claim_id": "scope-and-initialization-boundary",
      "text": "Spring Framework 7.0.8 documents singleton as the default scope and prototype as a new instance per request; all scopes receive initialization callbacks, but configured destruction callbacks for prototypes are not called and client code must release expensive resources. It also documents that @PostConstruct and initialization methods run within the singleton creation lock and should not access external beans because of initialization-deadlock risk.",
      "source_ids": ["spring7-scopes", "spring7-lifecycle"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "常见追问", "易错点"]
    }
