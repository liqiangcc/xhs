{"schema_version":"answer_evidence.v1","canonical_id":"cq_spring_transaction_a3b170d7","candidate_sha256":"5e2611b872069bf7eff187f7dbe81bb58ddd9ab52b224c7d1c751be804004be4","checked_at":"2026-07-11","writer":{"writer_id":"codex-long-tail-parallel-v1","writer_version":"xhs-answer-curator.v1"},"sources":[{"source_id":"implementation","title":"Spring declarative transaction implementation","locator":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/tx-decl-explained.html","source_type":"official_documentation","checked_at":"2026-07-11"},{"source_id":"annotations","title":"Spring @Transactional reference","locator":"https://docs.spring.io/spring/reference/6.2/data-access/transaction/declarative/annotations.html","source_type":"official_documentation","checked_at":"2026-07-11"},{"source_id":"proxying","title":"Spring AOP proxying mechanisms","locator":"https://docs.spring.io/spring-framework/reference/core/aop/proxying.html","source_type":"official_documentation","checked_at":"2026-07-11"},{"source_id":"rollback","title":"Spring declarative transaction rollback rules","locator":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/rolling-back.html","source_type":"official_documentation","checked_at":"2026-07-11"},{"source_id":"overview","title":"Spring declarative transaction management overview","locator":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative.html","source_type":"official_documentation","checked_at":"2026-07-11"}],"claims":[{"claim_id":"flow","text":"Spring combines AOP proxies, transaction metadata, TransactionInterceptor and an appropriate TransactionManager around method invocations.","source_ids":["implementation"],"answer_locations":["核心结论","1 分钟版","3 分钟版","原理机制"]},{"claim_id":"proxy-boundaries","text":"Default proxy mode intercepts calls entering through the proxy; self-invocation bypasses advice, initialization is a boundary, and CGLIB cannot proxy final classes or advise final/private methods. AspectJ weaving differs.","source_ids":["annotations","proxying"],"answer_locations":["1 分钟版","3 分钟版","关键细节","常见追问","易错点"]},{"claim_id":"rollback-boundary","text":"Default declarative rollback is for unchecked exceptions; checked exceptions need configured rollback rules. Spring Framework 6.2 introduced the optional rollbackOn ALL_EXCEPTIONS default on EnableTransactionManagement.","source_ids":["rollback","annotations"],"answer_locations":["1 分钟版","3 分钟版","关键细节","常见追问","易错点"]},{"claim_id":"resource-boundary","text":"Transaction completion delegates to a configured transaction manager and Spring declarative transactions do not automatically propagate contexts across remote calls; concrete resource cost depends on that manager and configuration.","source_ids":["implementation","overview"],"answer_locations":["3 分钟版","关键细节","原理机制","易错点"]}],"source_question_coverage":[{"question_id":"a1e3b8d4c335e445d9361a9ca6a6d87f","covered":true,"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制"]},{"question_id":"b9dff9e53167d9f7ae12ee728618b475","covered":true,"answer_locations":["核心结论","1 分钟版","3 分钟版","关键细节","原理机制","常见追问"]}],"validation":{"source_check":"2026-07-11 official Spring documentation checked."},"review":{"reviewer_id":"spring_tx_isolated_review_r2","review_version":"xhs-isolated-review.v1","independent":true,"decision":"pass","revision_round":1,"hard_failures":[],"scores":{"facts_and_evidence":24,"directness_and_relevance":20,"type_specific_completeness":20,"mechanism_and_causality":15,"boundaries_and_tradeoffs":10,"followup_quality":5,"oral_quality":4},"revision_suggestions":[]},"review_history":[{"reviewer_id":"spring_tx_isolated_review","review_version":"xhs-isolated-review.v1","independent":true,"decision":"revise","revision_round":0,"hard_failures":["unsupported_factual_claim"],"finding":"The original constant-overhead assertion lacked an evidence and configuration boundary."}]}
