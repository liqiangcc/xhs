    {
      "claim_id": "source-boundary",
      "text": "All frozen repository variants ask for the difference between HashMap and Hashtable; the candidate stays on that comparison and does not invent project history.",
      "source_ids": ["repository-source"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "项目经验版"]
    },
    {
      "claim_id": "synchronization-selection",
      "text": "Java SE 21 documents HashMap as unsynchronized and Hashtable as synchronized, and recommends ConcurrentHashMap in place of Hashtable when a thread-safe highly-concurrent implementation is desired.",
      "source_ids": ["hashmap-api-se21", "hashtable-api-se21"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "原理机制", "常见追问"]
    },
    {
      "claim_id": "null-contract",
      "text": "HashMap permits null values and the null key, whereas Hashtable requires non-null keys and values and throws NullPointerException for null key/value operations such as put.",
      "source_ids": ["hashmap-api-se21", "hashtable-api-se21", "openjdk-hashtable-jdk21ga"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版", "常见追问"]
    },
    {
      "claim_id": "history-api-shape",
      "text": "Hashtable extends Dictionary, dates from Java 1.0 and was retrofitted in Java 2 v1.2 to implement Map, while HashMap is an AbstractMap-based Java Collections Framework implementation introduced in 1.2.",
      "source_ids": ["hashtable-api-se21", "hashmap-api-se21", "openjdk-hashtable-jdk21ga"],
      "answer_locations": ["核心结论", "1 分钟版", "3 分钟版"]
    },
    {
      "claim_id": "fail-fast-boundary",
      "text": "HashMap's fail-fast iterator behavior is best-effort and must not be used as a correctness or synchronization mechanism.",
      "source_ids": ["hashmap-api-se21"],
      "answer_locations": ["关键细节", "常见追问", "易错点"]
    },
    {
      "claim_id": "synchronized-map-traversal-boundary",
      "text": "Collections.synchronizedMap requires access through the returned map and manual synchronization on that map when traversing its collection views, so the wrapper does not remove all caller-side synchronization obligations.",
      "source_ids": ["collections-api-se21"],
      "answer_locations": ["关键细节"]
    },
    {
      "claim_id": "implementation-version-boundary",
      "text": "JDK 21 GA implementation details such as HashMap tree-bin machinery and Hashtable's synchronized legacy table/rehash structure are version-bound implementation details, not the primary cross-version semantic comparison.",
      "source_ids": ["openjdk-hashmap-jdk21ga", "openjdk-hashtable-jdk21ga"],
