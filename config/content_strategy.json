{
  "schema_version": "content_strategy.v1",
  "audience": "mid_to_senior_java_backend",
  "build_order": "high_value_first_full_coverage_final",
  "batch_size": 10,
  "final_coverage": {
    "reviewable_assigned_rate": 1,
    "invalid_reason_rate": 1,
    "answer_ready_rate": 1,
    "reviewability_rate": 1,
    "unreachable_question_count": 0
  },
  "milestones": [
    {
      "stage": "C2",
      "canonical_min": 60,
      "assigned_rows_min": 200
    },
    {
      "stage": "C5",
      "canonical_min": 100,
      "assigned_rows_min": 300
    },
    {
      "stage": "C6",
      "canonical_min": 200,
      "assigned_rows_min": 600
    },
    {
      "stage": "C7",
      "reviewable_assigned_rate": 1,
      "invalid_reason_rate": 1
    },
    {
      "stage": "C8",
      "answer_ready_rate": 1
    },
    {
      "stage": "C9",
      "reviewability_rate": 1,
      "unreachable_question_count": 0
    }
  ],
  "candidate_priority": [
    "attach_existing_canonical",
    "distinct_company_count",
    "question_frequency",
    "experienced_hire_relevance",
    "core_backend_entity",
    "topic_coverage_gap",
    "stable_question_id"
  ],
  "initial_batch_quotas": {
    "java_collections_jvm_concurrency": 10,
    "mysql_database": 8,
    "redis_cache": 5,
    "spring": 4,
    "kafka_rocketmq": 4,
    "network_operating_system": 4,
    "system_design": 3,
    "algorithm": 2
  },
  "required_topics": [
    {
      "id": "java_language_collections",
      "title": "Java 集合与语言基础",
      "entities": ["Java", "HashMap", "ConcurrentHashMap", "ArrayList", "String", "反射", "SPI"],
      "must_cover": ["集合结构与扩容", "equals/hashCode", "泛型与反射", "字符串与不可变性", "设计模式与 SPI"]
    },
    {
      "id": "java_concurrency",
      "title": "Java 并发与 JUC",
      "entities": ["线程池", "synchronized", "volatile", "CAS", "AQS", "ThreadLocal", "ReentrantLock"],
      "must_cover": ["线程生命周期", "内存可见性", "锁实现与公平性", "线程池参数与拒绝策略", "原子类与 ABA", "ThreadLocal 泄漏"]
    },
    {
      "id": "jvm",
      "title": "JVM",
      "entities": ["JVM", "GC", "ClassLoader", "对象内存", "JMM"],
      "must_cover": ["运行时内存", "对象创建", "垃圾回收", "类加载与双亲委派", "内存与 CPU 排障"]
    },
    {
      "id": "mysql",
      "title": "MySQL",
      "entities": ["MySQL", "B+树", "索引", "MVCC", "锁", "redo log", "undo log", "binlog"],
      "must_cover": ["索引结构", "事务与隔离", "MVCC 与锁", "三类日志", "主从复制", "SQL 优化与 EXPLAIN"]
    },
    {
      "id": "redis",
      "title": "Redis",
      "entities": ["Redis", "RDB", "AOF", "Cluster", "Sentinel", "分布式锁", "big key", "hot key"],
      "must_cover": ["数据结构", "持久化", "过期与淘汰", "高可用", "缓存穿透击穿雪崩", "一致性", "分布式锁"]
    },
    {
      "id": "spring",
      "title": "Spring",
      "entities": ["Spring", "IoC", "Bean", "AOP", "事务", "循环依赖", "Spring MVC"],
      "must_cover": ["容器启动与 Bean 生命周期", "依赖注入", "AOP", "事务传播与失效", "循环依赖", "MVC 请求链路"]
    },
    {
      "id": "message_queue",
      "title": "Kafka / RocketMQ",
      "entities": ["Kafka", "RocketMQ", "消息队列", "幂等", "顺序消息", "事务消息"],
      "must_cover": ["核心架构", "可靠投递", "重复消费", "顺序性", "消息积压", "事务与最终一致性"]
    },
    {
      "id": "network_os",
      "title": "计算机网络与操作系统",
      "entities": ["TCP", "UDP", "HTTP", "HTTPS", "epoll", "进程", "线程", "IPC"],
      "must_cover": ["TCP 建连与断连", "HTTP/HTTPS", "IO 多路复用", "进程线程", "进程间通信"]
    },
    {
      "id": "distributed_system",
      "title": "高并发与分布式系统设计",
      "entities": ["高并发", "限流", "熔断", "幂等", "分布式锁", "分布式事务", "分库分表"],
      "must_cover": ["容量评估", "缓存与削峰", "一致性与幂等", "限流熔断降级", "高可用", "数据拆分"]
    },
    {
      "id": "troubleshooting",
      "title": "线上排障与性能优化",
      "entities": ["链路追踪", "慢查询", "CPU", "内存泄漏", "GC", "监控", "压测"],
      "must_cover": ["问题分层", "观测指标", "止血", "根因定位", "容量压测", "复盘与防复发"]
    }
  ],
  "answer_types": {
    "concept": {
      "required_sections": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "项目经验版", "常见追问", "易错点"],
      "additional_requirements": ["comparison_dimensions", "selection_conditions", "counterexample", "three_answered_followups"]
    },
    "mechanism": {
      "required_sections": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "项目经验版", "常见追问", "易错点"],
      "additional_requirements": ["core_data_structure", "main_flow", "version_boundary", "performance_boundary", "three_answered_followups"]
    },
    "scenario": {
      "required_sections": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "项目经验版", "常见追问", "易错点"],
      "additional_requirements": ["requirements", "capacity", "core_flow", "consistency", "failure_degradation", "observability", "tradeoffs", "three_answered_followups"]
    },
    "coding": {
      "required_sections": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "项目经验版", "常见追问", "易错点"],
      "additional_requirements": ["invariant", "java_implementation", "complexity", "edge_cases", "variant", "three_answered_followups"]
    },
    "project": {
      "required_sections": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "项目经验版", "常见追问", "易错点"],
      "additional_requirements": ["real_context_placeholder", "personal_responsibility", "decision", "metric", "tradeoff", "retrospective", "no_fabricated_experience"]
    },
    "behavior": {
      "required_sections": ["核心结论", "1 分钟版", "3 分钟版", "关键细节", "原理机制", "项目经验版", "常见追问", "易错点"],
      "additional_requirements": ["real_star_evidence", "measurable_result", "reflection", "no_fabricated_experience"]
    }
  },
  "exclusion_reasons": [
    "not_a_question",
    "incomplete_or_unreadable",
    "extraction_noise",
    "other"
  ],
  "metrics": {
    "reviewable_assigned_rate": "assigned reviewable question rows / all reviewable question rows",
    "invalid_reason_rate": "excluded rows with exclusion_reason / all excluded rows",
    "answer_ready_rate": "canonical records with ready answers / all canonical records",
    "reviewability_rate": "reviewable rows with canonical, ready answer and progress / all reviewable rows",
    "unreachable_question_count": "reviewable rows missing any canonical, answer, progress or discovery path"
  }
}
